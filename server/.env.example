# Copie este arquivo para ".env" e edite com os seus valores.
#   cp .env.example .env
# O arquivo .env fica só no seu servidor (não vai pro git) — sem conflitos no pull.

# Chave secreta exigida no app (a mesma vai na engrenagem do app).
API_KEY=troque-esta-chave

# URL pública pela qual o celular do cliente acessa o servidor.
#   rede local: http://192.168.0.10:8080
#   domínio/HTTPS: https://videos.seudominio.com
PUBLIC_BASE_URL=http://SEU_IP:8080

# --- Velocidade ---
# CPU (padrão, funciona em qualquer lugar). Use "ultrafast" para o máximo de velocidade.
VIDEO_ENCODER=libx264
VIDEO_PRESET=veryfast
VIDEO_CRF=23
MAX_HEIGHT=1080

# --- Aceleração por hardware Intel (i3/i5/i7 com Quick Sync) ---
# Para ativar: troque a linha de cima para VIDEO_ENCODER=h264_vaapi
# E descomente o bloco "devices: - /dev/dri:/dev/dri" no docker-compose.yml.
LIBVA_DRIVER_NAME=iHD
